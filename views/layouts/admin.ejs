<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= siteConfig.siteName || 'LinearPress' %> Admin</title><% for (const css of pluginStyleUrls) { %><link rel="stylesheet" href="<%= css %>"><% } %><% if (typeof fluentThemeCss === 'string' && fluentThemeCss) { %><style><%- fluentThemeCss %></style><% } %><script>(function(){try{var t=localStorage.getItem('fluent-theme');if(!t)t=(window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';document.documentElement.dataset.theme=t;}catch(e){document.documentElement.dataset.theme='light';}})();</script><script type="module" src="/plugins/fluentui-theme/vendor/web-components-all.min.js"></script><script type="module" src="/plugins/fluentui-theme/fluent-init.js"></script></head><body class="fluent-admin"><header class="a-header"><div class="a-header-inner"><button type="button" class="a-burger" id="adminBurger" aria-label="打开导航菜单" aria-expanded="false"><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M2.5 5a.75.75 0 0 1 .75-.75h13.5a.75.75 0 0 1 0 1.5H3.25A.75.75 0 0 1 2.5 5Zm.75 4.25h13.5a.75.75 0 0 1 0 1.5H3.25a.75.75 0 0 1 0-1.5Zm0 5h13.5a.75.75 0 0 1 0 1.5H3.25a.75.75 0 0 1 0-1.5Z"/></svg></button><a class="a-brand" href="/"><%= siteConfig.siteName || 'LINEARPRESS' %></a><span class="a-crumb"><%= title %></span><div class="a-header-right"><label class="a-theme-toggle" title="切换深色模式"><fluent-switch data-fluent-theme-toggle aria-label="切换深色模式"></fluent-switch></label><span class="a-user"><%= currentUser?.username %></span></div></div></header><div class="a-shell"><aside class="admin-side"><nav class="a-nav"><% adminMenu.forEach(item => { if (item.children && item.children.length) { %><div class="a-nav-group" data-admin-group><a class="a-nav-item a-nav-parent<%= item.children.some(c => currentPath === c.link || (item.link && currentPath === item.link)) ? ' active' : '' %>" href="<%= item.link %>"><%= item.title %><span class="a-nav-caret">▾</span></a><div class="admin-nav-children<%= item.children.some(c => currentPath === c.link) ? ' is-open' : '' %>"><% item.children.forEach(child => { %><a class="a-nav-item a-nav-child<%= currentPath === child.link ? ' active' : '' %>" href="<%= child.link %>"><%= child.title %></a><% }) %></div></div><% } else { %><a class="a-nav-item<%= currentPath === item.link ? ' active' : '' %>" href="<%= item.link %>"><%= item.title %></a><% } }) %></nav></aside><main class="a-main"><div class="a-content"><%- body %></div></main><aside class="a-panel"><h3 class="a-panel-title">详情面板</h3><div class="a-panel-card"><p class="a-panel-eyebrow">SITE</p><strong class="a-panel-name"><%= siteConfig.siteName || 'LINEARPRESS' %></strong><p class="a-panel-muted"><%= siteConfig.siteDescription %></p></div><div class="a-panel-card"><p class="a-panel-eyebrow">MAINTENANCE</p><div class="a-maint"><fluent-badge appearance="<%= maintenanceEnabled ? 'filled' : 'outline' %>" color="<%= maintenanceEnabled ? 'danger' : 'neutral' %>"><%= maintenanceEnabled ? '开启' : '关闭' %></fluent-badge><span class="a-panel-muted"><%= maintenanceEnabled ? '维护模式已开启' : '维护模式已关闭' %></span></div></div><% adminPanels.forEach(panel => { %><div class="a-panel-card a-panel-inject"><%- panel.html %></div><% }) %></aside></div><div class="admin-overlay" id="adminOverlay" data-open="false"></div><% for (const script of pluginScriptUrls) { %><script src="<%= script %>" defer></script><% } %></body></html>