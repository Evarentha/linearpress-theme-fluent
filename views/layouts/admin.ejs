<%#
  Fluent theme · admin layout: app bar, Nav drawer, content canvas.

  Authors:
  MoyuZJ <moyuzj@evarentha.com> @LinearTeam - Made in China with ♥
  worryzu <worryzu@evarentha.com> @LinearTeam

  Copyright (C) 2026 Evarentha
  SPDX-License-Identifier: GPL-3.0-or-later

  Same locals and slots as the core admin layout (adminNav, pageTitle, crumbs,
  narrow, focusMode; admin.head, admin.body.end). Nav icons: the item's own
  `icon` when it names a Fluent icon, else by route, else a generic one.
%><%
const ROUTE_ICONS = [
  ['/admin/posts', 'document_text'], ['/admin/comments', 'comment'], ['/admin/users', 'people'], ['/admin/groups', 'shield_person'],
  ['/admin/appearance', 'paint_brush'], ['/admin/plugins', 'puzzle_piece'], ['/admin/settings', 'settings'],
  ['/admin/shuoshuo', 'chat'], ['/admin/categories', 'tag'], ['/admin/media-library', 'image_multiple'], ['/admin/pages', 'document_one_page'],
  ['/admin/static', 'folder'], ['/admin/advanced-comments', 'comment_multiple'], ['/admin/account-security', 'lock_closed'],
  ['/admin/two-factor', 'shield_keyhole'], ['/admin/sso', 'person_key'], ['/admin/mysql', 'database'], ['/admin/import', 'arrow_import']
];
const KNOWN = new Set(['board','document_text','comment','people','people_team','shield_person','paint_brush','puzzle_piece','settings','chat','tag','image_multiple','document_one_page','folder','comment_multiple','lock_closed','shield_keyhole','person_key','database','arrow_import','apps','home','archive','calendar','eye','edit','person','rss']);
const navIcon = (item) => {
  if (item.icon && KNOWN.has(item.icon)) return item.icon;
  if (item.link === '/admin') return 'board';
  const hit = ROUTE_ICONS.filter(([prefix]) => item.link === prefix || item.link.startsWith(prefix + '/')).sort((a, b) => b[0].length - a[0].length)[0];
  return hit ? hit[1] : 'apps';
};
const focus = typeof focusMode !== 'undefined' && focusMode;
const crumbList = typeof crumbs !== 'undefined' && crumbs ? crumbs : [];
const title = typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : '';
const initial = (siteConfig.siteName || 'L').trim().slice(0, 1).toUpperCase();
%><!doctype html>
<html lang="zh-CN"<%- filter('admin.htmlAttributes', '') %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="color-scheme" content="light dark">
<title><%= title || '管理后台' %> · <%= siteConfig.siteName %></title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script>(function(){try{var t=localStorage.getItem('lp-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}addEventListener('pagereveal',function(e){if(e.viewTransition)document.documentElement.classList.add('f-vt')})})()</script>
<link rel="stylesheet" href="/css/lp-base.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/plugins/fluentui-theme/fluent-icons.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/plugins/fluentui-theme/fluent.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/plugins/fluentui-theme/fluent-admin.css?v=<%= assetVersion %>">
<% for (const href of styleUrls) { %><link rel="stylesheet" href="<%= href %>">
<% } %><%- slot('admin.head') %>
</head>
<body class="lp-admin f-admin<%= focus ? ' admin-focus' : '' %>">
<div class="f-app" data-admin-shell>
  <header class="f-appbar">
    <button type="button" class="f-icon-btn f-drawer-toggle" data-drawer-toggle aria-controls="admin-side" aria-expanded="false" aria-label="打开导航"><%- include('../fluentui-theme/icon', { name: 'navigation' }) %></button>
    <a class="f-appbar-brand" href="/admin"><span class="f-logo" aria-hidden="true"><%= initial %></span><span class="f-appbar-name"><%= siteConfig.siteName %></span></a>
    <span class="f-appbar-divider" aria-hidden="true"></span>
    <span class="f-appbar-app">管理后台</span>
    <div class="f-appbar-end">
      <a class="f-icon-btn" href="/" target="_blank" rel="noopener" aria-label="查看站点" title="查看站点"><%- include('../fluentui-theme/icon', { name: 'open' }) %></a>
      <button type="button" class="f-icon-btn" data-theme-toggle aria-label="切换浅色 / 深色" title="切换浅色 / 深色"><%- include('../fluentui-theme/icon', { name: 'dark_theme' }) %></button>
      <div class="menu user-menu" data-menu>
        <button type="button" class="menu-trigger" aria-haspopup="true" aria-expanded="false" aria-label="账户菜单"><%- avatar(currentUser, 32) %></button>
        <div class="menu-panel" role="menu">
          <div class="menu-head"><%- avatar(currentUser, 40) %><strong><%= displayName(currentUser) %></strong><span>@<%= currentUser.username %></span></div>
          <hr>
          <% for (const item of menu('user.menu')) { %><a role="menuitem" href="<%= item.href %>"><%- include('../fluentui-theme/icon', { name: item.href === '/account' ? 'lock_closed' : /edit/.test(item.href) ? 'edit' : 'person' }) %><%= item.title %></a><% } %>
          <a role="menuitem" href="/" target="_blank" rel="noopener"><%- include('../fluentui-theme/icon', { name: 'open' }) %>查看站点</a>
          <hr>
          <form method="post" action="/logout"><button type="submit" role="menuitem" class="danger"><%- include('../fluentui-theme/icon', { name: 'sign_out' }) %>退出登录</button></form>
        </div>
      </div>
    </div>
  </header>

  <aside class="f-nav" id="admin-side" aria-label="后台导航">
    <nav class="f-nav-body">
      <% for (const group of adminNav) { %>
      <div class="f-nav-group">
        <% if (group.title) { %><h2 class="f-nav-section"><%= group.title %></h2><% } %>
        <% for (const item of group.items) { %>
        <a class="f-nav-item" href="<%= item.link %>"<%- item.active ? ' aria-current="page"' : '' %>>
          <% if (item.active) { %><span class="f-nav-indicator" aria-hidden="true"></span><% } %>
          <%- include('../fluentui-theme/icon', { name: navIcon(item), swap: true }) %>
          <span class="f-nav-label"><%= item.title %></span>
          <% if (item.badge) { %><span class="f-counter" aria-label="<%= item.badge %> 条待处理"><%= item.badge %></span><% } %>
        </a>
        <% } %>
      </div>
      <% } %>
    </nav>
    <div class="f-nav-foot"><span>LinearPress</span><span class="num">v<%= LINEARPRESS_VERSION %></span></div>
  </aside>

  <main class="f-content admin-content<%= typeof narrow !== 'undefined' && narrow ? ' is-narrow' : '' %>" id="main">
    <% if (!focus && crumbList.length) { %>
    <nav class="f-breadcrumb" aria-label="位置">
      <ol>
        <% for (const crumb of crumbList) { %><li><a href="<%= crumb.href %>"><%= crumb.title %></a><%- include('../fluentui-theme/icon', { name: 'chevron_right', size: 12, cls: 'f-breadcrumb-sep' }) %></li><% } %>
        <li aria-current="page"><span><%= title %></span></li>
      </ol>
    </nav>
    <% } %>
    <% if (!focus) { %><%- include('partials/alerts') %><% } %>
    <%- body %>
  </main>
</div>
<script src="/js/lp.js?v=<%= assetVersion %>" defer></script>
<script src="/js/admin.js?v=<%= assetVersion %>" defer></script>
<script src="/plugins/fluentui-theme/fluent.js?v=<%= assetVersion %>" defer></script>
<% for (const script of scripts) { %><script src="<%= script.src %>"<%- script.module ? ' type="module"' : ' defer' %>></script>
<% } %><%- slot('admin.body.end') %>
</body>
</html>
