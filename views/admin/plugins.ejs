<!--
  Admin plugin management page for the Fluent UI theme, overriding the core
  admin/plugins view. Offers npm and ZIP install forms plus a
  drag-reorderable plugin list. The element IDs and class names required by
  the core drag and install scripts are preserved.
  @since 1.0.0
-->

<div class="a-page-head"><div><h1 class="a-title">插件</h1><p class="a-eyebrow">拖动条目调整加载顺序</p></div></div><section class="a-panel-card a-install"><h2 class="a-section-title">安装插件</h2><form id="npm-install-form" class="a-install-row"><fluent-text-input id="npm-package-name" placeholder="@scope/plugin-name 或 plugin-name@1.0.0" autocomplete="off" required></fluent-text-input><fluent-button type="submit" appearance="primary">从 npm 安装</fluent-button></form><form id="zip-install-form" class="a-install-row"><label class="a-file-label">选择 ZIP 文件<input type="file" id="zip-file" accept=".zip,application/zip,application/x-zip-compressed" multiple hidden></label><label class="a-batch-toggle"><fluent-checkbox id="zip-batch"><span>批量安装</span></fluent-checkbox></label><fluent-button type="submit" appearance="primary">上传 ZIP 安装</fluent-button></form><p id="install-status" class="a-notice" hidden></p></section><ol class="a-plugin-list" id="plugin-list"><% plugins.forEach(plugin => { %><li draggable="true" data-plugin-id="<%= plugin.id %>" class="a-plugin-row"><span class="a-drag-handle">⋮⋮</span><div class="a-plugin-icon"><% if (plugin.icon) { %><%= plugin.icon %><% } else { %><%= (plugin.name || plugin.id)[0].toUpperCase() %><% } %></div><div class="a-plugin-info"><strong class="a-plugin-name"><%= plugin.name %></strong><small class="a-plugin-meta"><%= plugin.id %> · v<%= plugin.version %><% if (plugin.description) { %> · <%= plugin.description %><% } %></small></div><fluent-badge appearance="<%= plugin.enabled ? 'filled' : 'outline' %>" color="<%= plugin.enabled ? 'brand' : 'neutral' %>"><%= plugin.enabled ? '启用' : '停用' %></fluent-badge><div class="a-plugin-actions"><% customSettingsFor(plugin.id).forEach(entry => { %><a href="<%= entry.link || ('/admin/plugins/' + plugin.id + '/settings') %>"><fluent-button appearance="outline" size="small"><%= entry.label %></fluent-button></a><% }) %><a href="/admin/plugins/<%= plugin.id %>/settings"><fluent-button appearance="outline" size="small">设置</fluent-button></a><form method="post" action="/admin/plugins/<%= plugin.id %>/toggle"><fluent-button type="submit" appearance="outline" size="small"><%= plugin.enabled ? '停用' : '启用' %></fluent-button></form><% if (!builtinPlugins.includes(plugin.id)) { %><form method="post" action="/admin/plugins/<%= plugin.id %>/uninstall" onsubmit="return confirm('删除将移除插件目录及其数据，继续吗？')"><fluent-button type="submit" appearance="outline" size="small" class="a-danger">删除</fluent-button></form><% } %></div></li><% }) %></ol><p id="sort-status" class="a-notice" hidden>顺序已保存。</p><script src="/js/plugin-sort.js" defer></script><script src="/js/plugin-install.js" defer></script>