  Made by MoyuZJ in China with ♥
  Fluent UI 主题 —— 站点设置（覆盖核心 admin/settings；保留 settings.js 的标签页/域名列表契约）
-->

<div class="a-page-head"><div><h1 class="a-title">站点设置</h1></div></div><% if (notice) { %><fluent-message-bar intent="success"><div>已保存。</div></fluent-message-bar><% } %><nav class="a-settings-tabs" role="tablist"><button type="button" class="settings-tab active" data-tab="site">站点信息</button><button type="button" class="settings-tab" data-tab="datetime">日期格式</button><button type="button" class="settings-tab" data-tab="domain">域名设置</button><button type="button" class="settings-tab" data-tab="permalink">路由格式</button><button type="button" class="settings-tab" data-tab="footer">页脚声明</button></nav><section class="settings-panel active a-settings-panel" data-panel="site"><h2 class="a-section-title">站点信息</h2><form method="post" action="/admin/settings/site" class="a-editor-form"><div class="a-field"><label class="a-field-label" for="site-name">站点名称 (siteName)</label><fluent-text-input id="site-name" name="siteName" value="<%= config.siteName %>" placeholder="LinearPress" appearance="outline"></fluent-text-input></div><div class="a-field"><label class="a-field-label" for="site-title">站点标题 (siteTitle)</label><fluent-text-input id="site-title" name="siteTitle" value="<%= config.siteTitle %>" placeholder="替换首页主标题 H1" appearance="outline"></fluent-text-input></div><div class="a-field"><label class="a-field-label" for="site-subtitle">站点副标题 (siteSubtitle)</label><fluent-text-input id="site-subtitle" name="siteSubtitle" value="<%= config.siteSubtitle %>" placeholder="替换首页副标题 H2" appearance="outline"></fluent-text-input></div><div class="a-field"><label class="a-field-label" for="site-description">站点介绍 (siteDescription)</label><fluent-text-area id="site-description" name="siteDescription" appearance="outline" rows="4"><%= config.siteDescription %></fluent-text-area><small class="a-field-hint">默认不展示，供主题渲染使用。</small></div><fluent-button type="submit" appearance="primary">保存站点信息</fluent-button></form></section><section class="settings-panel a-settings-panel" data-panel="datetime"><h2 class="a-section-title">日期与时间格式</h2><form method="post" action="/admin/settings/datetime" class="a-editor-form"><div class="a-field"><label class="a-field-label" for="time-source">时区 / 时间源 (timeSource)</label><fluent-text-input id="time-source" name="timeSource" value="<%= config.timeSource %>" placeholder="SYSTEM 或 ISO 8601（如 2026-01-01T12:00:00）" appearance="outline"></fluent-text-input><small class="a-field-hint">输入保留字 <code>SYSTEM</code> 强制使用服务器系统时间，或输入 ISO 8601 格式。</small></div><div class="a-field"><label class="a-field-label">日期格式 (dateFormat)</label><fluent-dropdown name="dateFormat" class="a-select"><% dateFormatOptions.forEach(option => { %><fluent-option value="<%= option.value %>" <%= config.dateFormat === option.value ? 'selected' : '' %>><%= option.label %></fluent-option><% }) %></fluent-dropdown></div><div class="a-field"><label class="a-field-label">时间格式 (timeFormat)</label><fluent-dropdown name="timeFormat" class="a-select"><% timeFormatOptions.forEach(option => { %><fluent-option value="<%= option.value %>" <%= config.timeFormat === option.value ? 'selected' : '' %>><%= option.label %></fluent-option><% }) %></fluent-dropdown></div><p class="a-preview-line">当前时间预览：<strong><%= formatDate(null) %></strong></p><fluent-button type="submit" appearance="primary">保存日期格式</fluent-button></form></section><section class="settings-panel a-settings-panel" data-panel="domain"><h2 class="a-section-title">域名设置</h2><form method="post" action="/admin/settings/domain" class="a-editor-form"><div class="a-field a-check-row"><fluent-checkbox name="autoDetect" <%= config.autoDetect ? 'checked' : '' %>><span>自动检测开关 (autoDetect)：开启后不进行任何重定向，保持用户访问的当前域名。</span></fluent-checkbox></div><div class="a-field"><label class="a-field-label" for="primary-domain">主域名 (primaryDomain)</label><fluent-text-input id="primary-domain" name="primaryDomain" value="<%= config.primaryDomain %>" placeholder="www.lp.cn" appearance="outline"></fluent-text-input></div><div class="a-field"><span class="a-field-label">备用域名 (backupDomains)</span><div id="domain-list" class="a-domain-list"><% if (config.backupDomains.length) { config.backupDomains.forEach(domain => { %><div class="domain-row a-domain-row"><fluent-text-input name="backupDomains" value="<%= domain %>" placeholder="http://cdn.lp.cn:1234" appearance="outline"></fluent-text-input><button type="button" class="a-domain-remove" aria-label="移除">✕</button></div><% }) } else { %><div class="domain-row a-domain-row"><fluent-text-input name="backupDomains" placeholder="http://cdn.lp.cn:1234" appearance="outline"></fluent-text-input><button type="button" class="a-domain-remove" aria-label="移除">✕</button></div><% } %></div><fluent-button id="domain-add" type="button" appearance="outline" size="small">+ 添加备用域名</fluent-button><small class="a-field-hint">通过备用域名访问时不触发重定向；其他域名会 301 跳转到主域名。</small></div><fluent-button type="submit" appearance="primary">保存域名设置</fluent-button></form></section><section class="settings-panel a-settings-panel" data-panel="permalink"><h2 class="a-section-title">路由格式</h2><form method="post" action="/admin/settings/permalink" class="a-editor-form"><div class="a-radio-grid"><% permalinkOptions.forEach(option => { %><label class="a-radio-row"><input type="radio" name="permalink" value="<%= option.value %>" <%= config.permalink === option.value ? 'checked' : '' %>><code><%= option.label %></code></label><% }) %></div><fluent-button type="submit" appearance="primary">保存路由格式</fluent-button></form></section><section class="settings-panel a-settings-panel" data-panel="footer"><h2 class="a-section-title">页脚声明</h2><form method="post" action="/admin/settings/footer" class="a-editor-form"><div class="a-field"><span class="a-field-label">版权声明预设</span><div class="a-radio-grid"><label class="a-radio-row"><input type="radio" name="footerCopyright" value="powered-by" <%= config.footerCopyright === 'powered-by' ? 'checked' : '' %>><span>由 LinearPress 强力驱动，基于 CordisJS。正在运行的版本为：<%= LINEARPRESS_VERSION %>。</span></label><label class="a-radio-row"><input type="radio" name="footerCopyright" value="running-on" <%= config.footerCopyright === 'running-on' ? 'checked' : '' %>><span>本站正在运行基于 CordisJS 的 LinearPress 版本 <%= LINEARPRESS_VERSION %>。</span></label><label class="a-radio-row"><input type="radio" name="footerCopyright" value="none" <%= config.footerCopyright === 'none' ? 'checked' : '' %>><span>不显示 (None)</span></label></div></div><div class="a-field"><span class="a-field-label">备案信息</span><div class="a-icp-row"><fluent-dropdown name="icpProvince" class="a-select a-icp-province"><fluent-option value="">省份简称</fluent-option><% ['京','津','冀','晋','蒙','辽','吉','黑','沪','苏','浙','皖','闽','赣','鲁','豫','鄂','湘','粤','桂','琼','渝','川','贵','云','藏','陕','甘','青','宁','新'].forEach(p => { %><fluent-option value="<%= p %>" <%= config.icpProvince === p ? 'selected' : '' %>><%= p %></fluent-option><% }) %></fluent-dropdown><span class="a-icp-text">ICP备</span><fluent-text-input name="icpNumber" value="<%= config.icpNumber %>" placeholder="备案号" appearance="outline" class="a-icp-number"></fluent-text-input><span class="a-icp-text">号</span></div><div class="a-icp-row"><span class="a-icp-text">国公网安备第</span><fluent-text-input name="policeNumber" value="<%= config.policeNumber %>" placeholder="公网安备号" appearance="outline" class="a-icp-number"></fluent-text-input><span class="a-icp-text">号</span></div><small class="a-field-hint">提供「不显示」选项：清空备案号即可。</small></div><div class="a-field"><label class="a-field-label" for="footer-html">自定义 HTML 页脚</label><fluent-text-area id="footer-html" name="footerHtml" class="a-code-field" appearance="outline" rows="4"><%= config.footerHtml %></fluent-text-area><small class="a-field-hint">常用于放置第三方认证徽章或友链，如“可信网站”“本站由某某云提供计算服务”。</small></div><fluent-button type="submit" appearance="primary">保存页脚声明</fluent-button></form></section><section class="a-panel-card a-maintenance-panel"><h2 class="a-section-title">维护模式</h2><p class="a-panel-muted">手动开启维护模式后，普通访问会被静态维护页拦截，管理员仍可通过 <code>/login</code> 与 <code>/admin</code> 访问控制台。</p><form method="post" action="/admin/maintenance/toggle"><fluent-button type="submit" appearance="<%= maintenanceEnabled ? 'outline' : 'primary' %>"><%= maintenanceEnabled ? '关闭维护模式' : '开启维护模式' %></fluent-button></form></section><script src="/js/settings.js" defer></script>