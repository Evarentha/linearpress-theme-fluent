  Fluent UI 主题 —— 文章管理（覆盖核心 admin/posts）
-->

<div class="a-page-head"><div><h1 class="a-title">文章</h1><p class="a-eyebrow"><<%= posts.length %> 篇文章</p></div><a href="/admin/posts/new"><fluent-button appearance="primary">+ 新建</fluent-button></a></div><div class="a-table-wrap"><table class="a-table"><thead><tr><th>标题</th><th>状态</th><th>作者</th><th class="a-th-actions">操作</th></tr></thead><tbody><% posts.forEach(post => { %><tr><td class="a-cell-title"><a href="/admin/posts/<%= post.id %>/edit"><%= post.title %></a></td><td><fluent-badge appearance="<%= post.status === 'published' ? 'filled' : 'outline' %>" color="<%= post.status === 'published' ? 'brand' : 'neutral' %>"><%= post.status %></fluent-badge></td><td class="a-cell-muted"><%= post.author_name %></td><td class="a-cell-actions"><a href="/admin/posts/<%= post.id %>/edit"><fluent-button appearance="outline" size="small">编辑</fluent-button></a><form class="a-inline-form" method="post" action="/admin/posts/<%= post.id %>/delete" onsubmit="return confirm('删除后不可恢复，继续吗？')"><fluent-button type="submit" appearance="outline" size="small">删除</fluent-button></form></td></tr><% }) %></tbody></table></div>