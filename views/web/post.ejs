<!--
  Post reading page for the Fluent UI theme, overriding the core web/post
  view. Renders the article header and body, the comment list, and the
  comment form (guest or logged-in) with a live character counter.
  @since 1.0.0
-->

<article class="f-article"><div class="f-article-head"><div class="f-card-meta"><span class="f-meta-date"><%= formatDate(post.created_at) %></span><fluent-badge appearance="outline"><%= post.views %> 次浏览</fluent-badge></div><h1 class="f-title"><%= post.title %></h1></div><div class="f-article-body"><%- html %></div></article><% if (typeof advancedCommentsPartial === 'string' && advancedCommentsPartial) { %><div class="f-comments f-advanced-comments"><%- include(advancedCommentsPartial) %></div><% } else { %><section class="f-comments"><div class="f-section-row"><h2 class="f-section-title">评论</h2><fluent-badge appearance="outline"><%= comments.length %></fluent-badge></div><% if (typeof acCommentError === 'string' && acCommentError) { %><fluent-message-bar intent="error" role="alert"><div><%= acCommentError %></div></fluent-message-bar><% } %><% if (typeof notice !== 'undefined' && notice) { %><fluent-message-bar intent="success"><div>评论已提交，等待审核。</div></fluent-message-bar><% } %><% comments.forEach(comment => { %><div class="f-comment"><div class="f-comment-meta"><strong><%= comment.guest_name || '注册用户' %></strong><span class="f-comment-date"><%= formatDate(comment.created_at) %></span></div><p class="f-comment-body"><%= comment.content %></p></div><% }) %><% if (!comments.length) { %><p class="f-empty">还没有评论，来抢沙发。</p><% } %><form class="f-comment-form" method="post" action="<%= postUrl(post) %>/comments"><% if (typeof currentUser !== 'undefined' && currentUser) { %><p class="f-as">以 <strong><%= currentUser.username %></strong> 身份评论。</p><% } else { %><div class="f-comment-fields"><fluent-text-input name="guest_name" placeholder="姓名（必填）" required appearance="outline"></fluent-text-input><fluent-text-input name="guest_email" type="email" placeholder="邮箱（选填）" appearance="outline"></fluent-text-input></div><% } %><fluent-textarea name="content" placeholder="写下你的评论…" required appearance="outline" rows="5"></fluent-textarea><div class="f-comment-actions"><span class="f-char-count">0</span><fluent-button type="submit" appearance="primary">提交评论</fluent-button></div><button type="submit" hidden aria-hidden="true"></button></form></section><% } %>