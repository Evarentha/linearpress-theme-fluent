<!--
  Author: MoyuZJ
  Team: LinearTeam
  Contact: linearteam@foxmail.com
  Made by MoyuZJ in China with ♥
  Fluent UI 主题 —— 文章阅读页 + 评论区（覆盖核心 web/post）
-->

<article class="f-article"><div class="f-article-head"><div class="f-card-meta"><span class="f-meta-date"><%= formatDate(post.created_at) %></span><fluent-badge appearance="outline"><%= post.views %> 次浏览</fluent-badge></div><h1 class="f-title"><%= post.title %></h1></div><div class="f-article-body"><%- html %></div></article><section class="f-comments"><div class="f-section-row"><h2 class="f-section-title">评论</h2><fluent-badge appearance="outline"><%= comments.length %></fluent-badge></div><% if (notice) { %><fluent-message-bar intent="success"><div>评论已提交，等待审核。</div></fluent-message-bar><% } %><% comments.forEach(comment => { %><div class="f-comment"><div class="f-comment-meta"><strong><%= comment.guest_name || '注册用户' %></strong><span class="f-comment-date"><%= formatDate(comment.created_at) %></span></div><p class="f-comment-body"><%= comment.content %></p></div><% }) %><% if (!comments.length) { %><p class="f-empty">还没有评论，来抢沙发。</p><% } %><form class="f-comment-form" method="post" action="<%= postUrl(post) %>/comments"><% if (currentUser) { %><p class="f-as">以 <strong><%= currentUser.username %></strong> 身份评论。</p><% } else { %><div class="f-comment-fields"><fluent-text-input name="guest_name" placeholder="姓名（必填）" required appearance="outline"></fluent-text-input><fluent-text-input name="guest_email" placeholder="邮箱（选填）" appearance="outline"></fluent-text-input></div><% } %><fluent-text-area name="content" placeholder="写下你的评论…" required appearance="outline" rows="5"></fluent-text-area><div class="f-comment-actions"><span class="f-char-count">0</span><fluent-button type="submit" appearance="primary">提交评论</fluent-button></div><button type="submit" hidden aria-hidden="true"></button></form></section>