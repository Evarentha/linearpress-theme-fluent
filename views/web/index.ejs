<!--
  Homepage post list for the Fluent UI theme, overriding the core web/index
  view. Renders the hero (eyebrow, main title, subtitle; each hideable via
  the theme appearance config) and the post feed, which handles both regular
  posts and shuoshuo micro-post entries.
  @since 1.0.0
-->

<section class="f-intro f-hero"><% var ft = (typeof fluentTheme === 'object' && fluentTheme) ? fluentTheme : null; %><% if (!ft || ft.showEyebrow !== false) { %><p class="f-eyebrow"><%= siteConfig.siteName || 'INDEPENDENT PUBLISHING SYSTEM' %></p><% } %><% if (!ft || ft.showSiteTitle !== false) { %><h1 class="f-title"><%= siteConfig.siteTitle || '写下值得留下的内容。' %></h1><% } %><% if (!ft || ft.showSiteSubtitle !== false) { %><p class="f-lede"><%= siteConfig.siteSubtitle || 'LinearPress 是一个极简、可扩展、服务端渲染的写作空间。' %></p><% } %></section><section class="f-posts"><% posts.forEach(post => { %><% if (typeof isShuoShuo === 'function' && isShuoShuo(post.slug)) { %><article class="f-card f-card-shuoshuo"><div class="f-card-meta"><fluent-badge appearance="tint">说说</fluent-badge><span class="f-meta-date"><%= formatDate(post.created_at) %></span></div><div class="f-shuoshuo-body"><%- (typeof shuoshuoHtml === 'function') ? shuoshuoHtml(post) : post.title %></div></article><% } else { %><article class="f-card"><div class="f-card-main"><div class="f-card-meta"><span class="f-meta-date"><%= formatDate(post.created_at) %></span><fluent-badge appearance="outline"><%= post.views %> 次浏览</fluent-badge></div><h2 class="f-card-title"><a href="<%= postUrl(post) %>"><%= post.title %></a></h2></div><a class="f-card-link" href="<%= postUrl(post) %>">阅读<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7.5 1.5 13 8l-5.5 6.5V11H3V5h4.5V1.5Z"/></svg></a></article><% } %><% }) %><% if (!posts.length) { %><p class="f-empty">还没有发布任何文章。</p><% } %></section>