<!--
  Registration page for the Fluent UI theme, overriding the core auth/register
  view. Renders a centered card with username, optional email, and password
  fields, plus a link back to login.
  @since 1.0.0
-->

<section class="f-auth"><div class="f-auth-card"><div class="f-auth-head"><p class="f-eyebrow">NEW WRITER</p><h1 class="f-title">注册</h1></div><% if (error) { %><fluent-message-bar intent="error"><div><%= error %></div></fluent-message-bar><% } %><form method="post" action="/register" class="f-auth-form"><fluent-text-input name="username" placeholder="用户名" required appearance="outline"></fluent-text-input><fluent-text-input name="email" type="email" placeholder="邮箱（选填）" appearance="outline"></fluent-text-input><fluent-text-input name="password" type="password" placeholder="密码（至少 8 位）" required appearance="outline"></fluent-text-input><fluent-button type="submit" appearance="primary">创建账号</fluent-button><button type="submit" hidden aria-hidden="true"></button></form><a class="f-auth-alt" href="/login">已有账号 →</a></div></section>