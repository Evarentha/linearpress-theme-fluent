<!--
  Error page for the Fluent UI theme, overriding the core error view. Shows
  the passed-in title and message in a centered card with a link back to the
  homepage.
  @since 1.0.0
-->

<section class="f-auth"><div class="f-auth-card"><div class="f-auth-head"><p class="f-eyebrow">ERROR</p><h1 class="f-title"><%= title %></h1></div><p class="f-lede"><%= message %></p><a class="f-auth-alt" href="/">返回首页 →</a></div></section>